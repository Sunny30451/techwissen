# Öffentlicher Anwendungspfad. Muss mit dem Dokploy Domain Path übereinstimmen.
APP_BASE_PATH=/tech

POSTGRES_DB=techwissen
POSTGRES_USER=techwissen
POSTGRES_PASSWORD=replace-with-a-long-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-second-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Nur für docker-compose.local.yml
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
