# Optionale vollständige öffentliche Basis-URL.
# Beispiel: https://example.com/techwissen
# Wenn APP_BASE_URL leer/undefiniert ist, verwendet TechWissen als Pfad /<repositoryname>
# auf der von Dokploy konfigurierten Domain.
APP_BASE_URL=

POSTGRES_DB=techwissen
POSTGRES_USER=techwissen
POSTGRES_PASSWORD=replace-with-a-long-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-second-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Nur für docker-compose.local.yml
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080

# Artikel-Dateiuploads
ARTICLE_PACKAGE_MAX_MB=100
ARTICLE_MARKDOWN_MAX_MB=2
