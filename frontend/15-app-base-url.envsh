#!/bin/sh

raw_base_url=${APP_BASE_URL:-/}

case "$raw_base_url" in
  ""|"/")
    app_base_path=""
    ;;
  *)
    app_base_path="/${raw_base_url#/}"
    app_base_path="${app_base_path%/}"
    ;;
esac

if [ "$(printf '%s' "$app_base_path" | wc -l)" -ne 0 ] || \
   ! printf '%s\n' "$app_base_path" | grep -Eq '^(/[A-Za-z0-9._~%-]+)*$'; then
  echo >&2 'APP_BASE_URL must be a URL path such as "/" or "/tech-prod".'
  return 1
fi

APP_BASE_PATH_REGEX=$(printf '%s' "$app_base_path" | sed 's/[][\\.^$*+?{}|()]/\\&/g')
export APP_BASE_PATH_REGEX
