# =========================================================
# Hermes ↔ Discord – Dokploy Environment Beispiel
# =========================================================

# Secret
DISCORD_BOT_TOKEN=

# Empfohlen: dedizierter Discord-Kanal
DISCORD_ALLOWED_CHANNELS=

# Eine Zugriffspolitik MUSS produktiv gesetzt sein.
# Variante A: Benutzer
DISCORD_ALLOWED_USERS=

# Variante B: Discord-Rolle
DISCORD_ALLOWED_ROLES=

# Nur der dedizierte Channel arbeitet ohne @Mention.
DISCORD_FREE_RESPONSE_CHANNELS=

# In allen übrigen Kanälen weiterhin @Mention verlangen.
DISCORD_REQUIRE_MENTION=true

# Optional für Cron/Notification Delivery.
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_NAME=hermes

# NICHT produktiv empfohlen:
DISCORD_ALLOW_ALL_USERS=false
